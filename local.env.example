# Copy this file to `local.env` and set your device addresses.
#
# `local.env` is gitignored, so it is never published — the addresses in the docs are
# placeholders. `source local.env` to export the serials into your shell.
#
# Used by:
#   - the flow harness:            python3 -u test/run.py all --yes
#   - a phone lane:                python3 -u test/run.py all --yes --profile phone35
#   - the adb commands in the docs: source local.env; adb connect "$FIRE_TV_SERIAL"
#   - keeping the phone reachable:  source local.env; test/adb-keepalive.sh --daemon
#
# The profile names the variable it wants (`serial_env` in config.json), so a run with
# --profile phone35 picks up $PHONE_SERIAL with no --serial flag. An explicit --serial wins.
export FIRE_TV_SERIAL=192.168.1.50:5555
export PHONE_SERIAL=192.168.1.51:5555
