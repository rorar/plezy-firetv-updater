# Copy this file to `local.env` and set your Fire TV's LAN address.
#
# `local.env` is gitignored, so it is never published — the addresses in the docs are
# placeholders. `source local.env` to export FIRE_TV_SERIAL into your shell.
#
# Used by:
#   - the flow harness:            python3 -u test/run.py all --yes
#   - the adb commands in the docs: source local.env; adb connect "$FIRE_TV_SERIAL"
export FIRE_TV_SERIAL=192.168.1.50:5555
