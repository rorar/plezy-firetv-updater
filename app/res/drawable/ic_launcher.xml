<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <gradient
                android:angle="45"
                android:startColor="#1F3B57"
                android:endColor="#2F6E8F" />
        </shape>
    </item>
    <item android:top="18dp" android:bottom="18dp" android:left="18dp" android:right="18dp">
        <shape android:shape="rectangle">
            <solid android:color="#E8F1F8" />
            <corners android:radius="6dp" />
        </shape>
    </item>
</layer-list>
