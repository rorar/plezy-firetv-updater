<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="45"
                android:startColor="#15202B"
                android:centerColor="#1F3B57"
                android:endColor="#2F6E8F" />
        </shape>
    </item>
    <item android:left="40dp" android:right="40dp" android:top="60dp" android:bottom="60dp">
        <shape android:shape="rectangle">
            <solid android:color="#E8F1F8" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</layer-list>
